; Archivo de configuración del proyecto Godot.
; Las acciones de input NO están acá: se registran en runtime desde
; res://core/input/input_actions.gd (ver docs/DECISIONS.md).

config_version=5

[application]

config/name="Medoreador"
config/description="Shooter táctico de supervivencia en mundo abierto - Zona de Atucha / Delta del Paraná"
config/version="0.1.10-f1.10"
run/main_scene="res://ui/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Settings="*res://autoload/settings.gd"
Loc="*res://autoload/loc.gd"
AudioManager="*res://autoload/audio_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
GameState="*res://autoload/game_state.gd"
DebugTools="*res://autoload/debug_tools.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[internationalization]

locale/fallback="es"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
